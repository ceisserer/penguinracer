[resource]
script = ExtResource("5_eyfvy")
display_name = "Snow Park"
author = "PenguinRacer"
description = "A ski resort on a sunny mountain, from the summit restaurant to the village. Drop the open face, squeeze down the catwalks through the woods, fly the table-tops or slide the boxes, carve the berms of the slalom, ride the half-pipe, plunge down the chute, hammer through the moguls and finish off the big jump. Herring hang in the air: catch them in flight."
