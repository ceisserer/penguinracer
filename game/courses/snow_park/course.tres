script = ExtResource("5_eyfvy")
display_name = "Snow Park"
author = "PenguinRacer"
description = "A terrain park on a sunny slope. Pop off the rollers, fly the table-tops or slide the boxes, carve the berms of the slalom, ride the walls of the half-pipe, hammer through the moguls and finish off the big jump. Herring hang in the air: catch them in flight."
