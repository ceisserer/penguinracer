; Engine configuration file.
; PenguinRacer — Godot rebuild of Extreme Tux Racer.
; See ../godot-port-plan.md

config_version=5

[application]

config/name="PenguinRacer"
config/description="Downhill penguin racer with real snow deformation. Rebuild of Extreme Tux Racer 0.8.4."
config/version="0.1.0"
run/main_scene="res://scenes/race.tscn"
run/main_scene.spike="res://spikes/s1_pingpong/s1_spike.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":65,"physical_keycode":0,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":-1.0,"script":null)
]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":68,"physical_keycode":0,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":1.0,"script":null)
]
}
paddle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":87,"physical_keycode":0,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)
]
}
brake={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":83,"physical_keycode":0,"key_label":0,"unicode":115,"location":0,"echo":false,"script":null)
]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
trick_modifier={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194326,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
reset_race={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":82,"physical_keycode":0,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}

[internationalization]

; The 111 UI strings imported from ETR's `translations/` tree, in 13 languages.
; Registered here so the shell can call tr() with the semantic keys
; (PRESS_ANY_KEY_TO_START, SELECT_A_RACE, ...); legacy numeric IDs remain
; traceable through i18n/legacy_string_ids.cfg.
locale/translations=PackedStringArray("res://i18n/penguinracer.en.translation", "res://i18n/penguinracer.cs_CZ.translation", "res://i18n/penguinracer.de_DE.translation", "res://i18n/penguinracer.fi_FI.translation", "res://i18n/penguinracer.es_ES.translation", "res://i18n/penguinracer.fr_FR.translation", "res://i18n/penguinracer.pl_PL.translation", "res://i18n/penguinracer.pt_PT.translation", "res://i18n/penguinracer.se_SE.translation", "res://i18n/penguinracer.eo.translation", "res://i18n/penguinracer.du_NL.translation", "res://i18n/penguinracer.ro_RO.translation", "res://i18n/penguinracer.it_IT.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[importer_defaults]

; Godot imports textures without mipmaps by default, which is right for 2D and
; wrong for everything here: terrain albedo is sampled at grazing angles across
; the whole course and the object billboards recede to a few pixels. Without
; mipmaps both alias into a moving speckle. Set as an import default so a
; re-run of tools/import_all.sh cannot quietly undo it.
texture={
"mipmaps/generate": true
}

[autoload]

DebugCapture="*res://scripts/debug/debug_capture.gd"
