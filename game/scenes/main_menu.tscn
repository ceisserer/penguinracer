[node name="CourseMenu" parent="." instance=ExtResource("2_courses")]

[node name="SettingsMenu" parent="." instance=ExtResource("3_settings")]

[node name="Loading" type="CanvasLayer" parent="."]
layer = 20

[node name="Backdrop" type="ColorRect" parent="Loading"]
