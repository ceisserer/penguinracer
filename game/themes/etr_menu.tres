[resource]
resource_name = "ETR menu"

Label/colors/font_color = Color(1, 1, 1, 1)
Label/colors/font_outline_color = Color(0, 0, 0, 0)
Label/constants/outline_size = 0
Label/constants/shadow_offset_x = 0
Label/constants/shadow_offset_y = 0

DimLabel/base_type = &"Label"
DimLabel/colors/font_color = Color(0.7, 0.7, 0.7, 1)

AccentLabel/base_type = &"Label"
AccentLabel/colors/font_color = Color(1, 0.8, 0, 1)

Button/colors/font_color = Color(1, 1, 1, 1)
Button/colors/font_focus_color = Color(1, 0.8, 0, 1)
Button/colors/font_hover_color = Color(1, 0.8, 0, 1)
Button/colors/font_pressed_color = Color(1, 0.8, 0, 1)
Button/colors/font_hover_pressed_color = Color(1, 0.8, 0, 1)
Button/colors/font_disabled_color = Color(0.7, 0.7, 0.7, 1)
Button/colors/font_outline_color = Color(0, 0, 0, 0)
Button/constants/outline_size = 0
Button/styles/normal = SubResource("ButtonText")
Button/styles/hover = SubResource("ButtonText")
Button/styles/pressed = SubResource("ButtonText")
Button/styles/disabled = SubResource("ButtonText")
Button/styles/focus = SubResource("Empty")

; ETR's own checkbox is a ring with a cream tick in it, not a box
; (`TCheckbox` over textures/checkbox.png + checkmark_small.png). Redrawn as
; checkbox_{off,on}.png and bound to a [CheckBox], because Godot's default
; [CheckButton] switch is a dark slab that disappears against this blue.
CheckBox/colors/font_color = Color(1, 1, 1, 1)
CheckBox/colors/font_focus_color = Color(1, 0.8, 0, 1)
CheckBox/colors/font_hover_color = Color(1, 0.8, 0, 1)
CheckBox/colors/font_pressed_color = Color(1, 0.8, 0, 1)
CheckBox/colors/icon_normal_color = Color(1, 1, 1, 1)
CheckBox/colors/icon_focus_color = Color(1, 1, 1, 1)
CheckBox/colors/icon_hover_color = Color(1, 1, 1, 1)
CheckBox/colors/icon_pressed_color = Color(1, 1, 1, 1)
CheckBox/icons/unchecked = ExtResource("1_check_off")
CheckBox/icons/checked = ExtResource("2_check_on")
CheckBox/constants/h_separation = 10
CheckBox/styles/normal = SubResource("Empty")
CheckBox/styles/hover = SubResource("Empty")
CheckBox/styles/pressed = SubResource("Empty")
CheckBox/styles/disabled = SubResource("Empty")
CheckBox/styles/focus = SubResource("Empty")

CheckButton/colors/font_color = Color(1, 1, 1, 1)
CheckButton/colors/font_focus_color = Color(1, 0.8, 0, 1)
CheckButton/colors/font_hover_color = Color(1, 0.8, 0, 1)
CheckButton/colors/font_pressed_color = Color(1, 0.8, 0, 1)
CheckButton/colors/icon_normal_color = Color(1, 1, 1, 1)
CheckButton/colors/icon_focus_color = Color(1, 0.8, 0, 1)
CheckButton/colors/icon_hover_color = Color(1, 0.8, 0, 1)
CheckButton/colors/icon_pressed_color = Color(1, 0.8, 0, 1)
