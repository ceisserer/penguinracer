[gd_resource type="Theme" load_steps=17 format=3]

[ext_resource type="Texture2D" path="res://themes/checkbox_off.png" id="1_check_off"]
[ext_resource type="Texture2D" path="res://themes/checkbox_on.png" id="2_check_on"]

; Extreme Tux Racer's GUI palette, as a Godot theme.
;
; Every colour here is one of the named constants in `etr-0.8.4/src/common.cpp`:
;   colBackgr  (0.4,  0.6, 0.8) the flat blue every menu screen is cleared to
;   colMBackgr (0.35, 0.5, 0.7) the fill of a framed box
;   colDBackgr (0.2,  0.3, 0.6) the recessed fill: a selected row, a slider track
;   colLBackgr (0.5,  0.7, 0.9) the raised fill: a scrollbar grabber
;   colWhite                    all text, and every frame outline
;   colDYell   (1.0,  0.8, 0.0) focus — text and outline both
;   colLGrey   (0.7,  0.7, 0.7) inactive text and secondary lines
;
; ETR's own widgets are drawn by SFML with square corners and a 3 px outline
; (`DrawFrameX`, `TFramedText`, `TTextField`), so nothing here is rounded.

[sub_resource type="StyleBoxEmpty" id="Empty"]

[sub_resource type="StyleBoxEmpty" id="ButtonText"]
content_margin_left = 20.0
content_margin_top = 6.0
content_margin_right = 20.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="Framed"]
content_margin_left = 18.0
content_margin_top = 14.0
content_margin_right = 18.0
content_margin_bottom = 14.0
bg_color = Color(0.35, 0.5, 0.7, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 1, 1, 1)

[sub_resource type="StyleBoxFlat" id="Field"]
content_margin_left = 14.0
content_margin_top = 6.0
content_margin_right = 14.0
content_margin_bottom = 6.0
bg_color = Color(0.35, 0.5, 0.7, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 1, 1, 1)

[sub_resource type="StyleBoxFlat" id="FieldFocus"]
content_margin_left = 14.0
