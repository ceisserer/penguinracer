content_margin_right = 14.0
content_margin_bottom = 6.0
bg_color = Color(0.35, 0.5, 0.7, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.8, 0, 1)

[sub_resource type="StyleBoxFlat" id="PictureFrame"]
