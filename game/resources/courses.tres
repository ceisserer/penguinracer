[sub_resource type="Resource" id="Resource_h1ii4"]
script = ExtResource("1_s2u4s")
dir = "this_means_something"
display_name = "This Means Thomething"
author = "Milo Fungus"
description = "This course was inspired by the Steven Spielberg film \"Close Encounters of the Third Kind\". Tux travels speedily towards the monolith over ice and snow through three difficult pathways. When he reaches the tower he must jump over it or get stuck in the trees and dirt. So that's sort of like going in a spacecraft. Kind of."
scene_path = "res://courses/this_means_something/course.tscn"
course_path = "res://courses/this_means_something/course.tres"
preview_path = "res://courses/this_means_something/preview.png"
world_size = Vector2(54, 800)
base_angle = 23.0

