[sub_resource type="Resource" id="Resource_pnmgb"]
script = ExtResource("1_s2u4s")
dir = "milos_castle"
display_name = "Milos Castle"
author = "Milo Fungus"
description = "The course starts out with raised icy paths that are difficult to stay on. Keep your speed down to get those herring, but speed up to make those jumps. If you're lined up just right, get ready for a jump. The course ends with snowy hills. You can get a few herring here, but look out for the vegetation."
scene_path = "res://courses/milos_castle/course.tscn"
course_path = "res://courses/milos_castle/course.tres"
preview_path = "res://courses/milos_castle/preview.png"
world_size = Vector2(54, 800)
base_angle = 23.0

